<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Coin Flip Chess - Online 1v1</title>
  <!-- PeerJS for zero-backend WebRTC multiplayer -->
  <script src="https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js"></script>
  <style>
    :root {
      --bg: #090d16;
      --card-bg: #131d2e;
      --board-light: #e2d6b5;
      --board-dark: #6e503b;
      --highlight-select: #f6e05e;
      --highlight-move: #84cc16;
      --accent: #38bdf8;
      --gold: #f59e0b;
      --text: #f8fafc;
      --muted: #94a3b8;
      --danger: #ef4444;
      --success: #10b981;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    body { background-color: var(--bg); color: var(--text); min-height: 100vh; display: flex; flex-direction: column; align-items: center; padding: 15px; }

    header { text-align: center; margin-bottom: 15px; }
    h1 { font-size: 1.8rem; color: var(--gold); display: flex; align-items: center; justify-content: center; gap: 10px; }
    .subtitle { color: var(--muted); font-size: 0.88rem; margin-top: 4px; }

    .main-container { display: flex; gap: 24px; max-width: 1080px; width: 100%; justify-content: center; flex-wrap: wrap; }

    /* Chessboard */
    .board-wrapper { display: flex; flex-direction: column; align-items: center; }
    .chessboard {
      width: 480px; height: 480px;
      display: grid; grid-template-columns: repeat(8, 1fr); grid-template-rows: repeat(8, 1fr);
      border: 8px solid #232f46; border-radius: 8px; overflow: hidden;
      box-shadow: 0 12px 35px rgba(0, 0, 0, 0.6);
      user-select: none;
      transition: transform 0.4s ease;
    }
    .chessboard.flipped {
      transform: rotate(180deg);
    }
    .chessboard.flipped .square {
      transform: rotate(180deg);
    }

    .square {
      position: relative; display: flex; align-items: center; justify-content: center;
      cursor: pointer; transition: background 0.15s;
    }
    .square.light { background-color: var(--board-light); }
    .square.dark { background-color: var(--board-dark); }
    .square.selected { background-color: var(--highlight-select) !important; }
    .square.last-move { background-color: rgba(246, 224, 94, 0.45) !important; }
    .square.in-check { background-color: rgba(239, 68, 68, 0.75) !important; }

    .square::after {
      content: ""; position: absolute; width: 16px; height: 16px; border-radius: 50%;
      background: rgba(0, 0, 0, 0.3); display: none; pointer-events: none;
    }
    .square.valid-move::after { display: block; }
    .square.valid-capture::after {
      width: 44px; height: 44px; border: 4px solid rgba(0, 0, 0, 0.35);
      background: transparent; border-radius: 50%;
    }

    .piece-svg { width: 90%; height: 90%; pointer-events: none; filter: drop-shadow(0 3px 4px rgba(0,0,0,0.45)); }

    /* Control Panel */
    .panel {
      background: var(--card-bg); border-radius: 12px; padding: 18px;
      width: 360px; display: flex; flex-direction: column; gap: 14px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4); border: 1px solid #232f46;
    }

    /* Multiplayer Status Bar */
    .net-box {
      background: #090d16; border-radius: 8px; padding: 10px 12px;
      border: 1px solid #1e293b; display: flex; flex-direction: column; gap: 8px; font-size: 0.82rem;
    }
    .net-header { display: flex; justify-content: space-between; align-items: center; font-weight: 600; }
    .role-badge { padding: 2px 8px; border-radius: 4px; font-weight: 800; font-size: 0.72rem; }
    .role-w { background: #fef08a; color: #713f12; }
    .role-b { background: #334155; color: #f8fafc; }
    .role-local { background: #0284c7; color: #fff; }

    /* Turn Status */
    .status-card {
      background: #090d16; border-radius: 8px; padding: 12px;
      border-left: 5px solid var(--accent); display: flex; flex-direction: column; gap: 8px;
    }
    .turn-row { display: flex; justify-content: space-between; align-items: center; font-size: 1.05rem; font-weight: 700; }
    .streak-container { display: flex; align-items: center; justify-content: space-between; font-size: 0.8rem; color: var(--muted); }
    .streak-pips { display: flex; gap: 5px; }
    .pip { width: 13px; height: 13px; border-radius: 50%; border: 2px solid #475569; }
    .pip.filled { background: var(--gold); border-color: var(--gold); box-shadow: 0 0 8px var(--gold); }

    /* Coin Flip Stage */
    .coin-stage {
      display: flex; flex-direction: column; align-items: center;
      padding: 12px; background: #090d16; border-radius: 8px; gap: 10px;
    }
    .coin-box { perspective: 800px; width: 90px; height: 90px; }
    .coin {
      width: 100%; height: 100%; border-radius: 50%; position: relative;
      transform-style: preserve-3d; transition: transform 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .coin-face {
      position: absolute; width: 100%; height: 100%; border-radius: 50%;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      font-weight: 900; font-size: 0.82rem; text-align: center; line-height: 1.2;
      backface-visibility: hidden;
      box-shadow: inset 0 0 0 4px rgba(255,255,255,0.4), 0 4px 10px rgba(0,0,0,0.5);
    }
    .coin-continue { background: linear-gradient(135deg, #10b981, #047857); color: #fff; }
    .coin-next { background: linear-gradient(135deg, #64748b, #334155); color: #fff; transform: rotateY(180deg); }

    .btn {
      background: #2563eb; color: #fff; border: none; padding: 9px 14px;
      font-size: 0.9rem; font-weight: 600; border-radius: 6px; cursor: pointer;
      display: inline-flex; align-items: center; justify-content: center; gap: 6px;
      transition: all 0.2s;
    }
    .btn:hover { background: #1d4ed8; transform: translateY(-1px); }
    .btn:disabled { opacity: 0.35; cursor: not-allowed; transform: none; }
    .btn-gold { background: #d97706; }
    .btn-gold:hover { background: #b45309; }
    .btn-sm { padding: 5px 10px; font-size: 0.78rem; }
    .btn-copy { background: #334155; }
    .btn-copy:hover { background: #475569; }

    .status-banner {
      font-size: 0.85rem; padding: 8px 10px; border-radius: 6px; text-align: center;
      background: #1e293b; font-weight: 600; min-height: 38px; display: flex; align-items: center; justify-content: center;
    }
    .status-banner.alert { background: #7f1d1d; color: #fecaca; }
    .status-banner.success { background: #14532d; color: #bbf7d0; }
    .status-banner.info { background: #1e3a8a; color: #bfdbfe; }

    .history-box {
      background: #090d16; border-radius: 6px; height: 95px; overflow-y: auto;
      padding: 8px; font-size: 0.78rem; font-family: monospace; display: flex; flex-direction: column; gap: 3px;
    }
    .history-entry { display: flex; justify-content: space-between; color: var(--muted); }
    .badge { padding: 1px 5px; border-radius: 4px; font-size: 0.68rem; font-weight: 700; }
    .badge-continue { background: #059669; color: #fff; }
    .badge-next { background: #475569; color: #fff; }
  </style>
</head>
